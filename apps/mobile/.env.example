# Physical phone over Wi-Fi: this must be the PC's LAN IP, NOT 10.0.2.2.
# 10.0.2.2 is the Android *emulator's* alias for the host loopback; on a real
# device it routes nowhere and every request fails with ERR_NETWORK.
#
# Fallback only — App.tsx prefers the Metro packager host at runtime.
# Update this if you need a fixed override; re-check with `ipconfig` after
# network changes.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.102:3001/api/v1

# Android emulator instead? Swap to:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001/api/v1

# Release builds (EAS or local `expo prebuild` + Gradle): there is no Metro host,
# so EXPO_PUBLIC_API_BASE_URL is the ONLY API target and App.tsx fails the build
# if it is missing or loopback. Use the deployed Railway service URL, e.g.:
# EXPO_PUBLIC_API_BASE_URL=https://api-production-<service>.up.railway.app/api/v1
# Once the API custom domain is live (DNS cutover), use the canonical URL:
# EXPO_PUBLIC_API_BASE_URL=https://api.gatewayglobal.africa/api/v1
EXPO_PUBLIC_MOCK_API=false

# Google OAuth client ID used by the Continue with Google button.
# Android (native builds/APK): use the ANDROID OAuth client ID (package
# com.gatewayglobal.ggapp + signing SHA-1). The app derives the OAuth redirect
# com.googleusercontent.apps.<client-id>:/oauth2redirect from it automatically;
# the scheme is registered in app.json.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=335540055294-raieetpuh61lvu9ar6vm2i49bnfu5kjb.apps.googleusercontent.com

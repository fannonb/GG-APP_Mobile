{
  "expo": {
    "name": "GG'APP",
    "slug": "gg-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "ggapp",
      "com.googleusercontent.apps.335540055294-raieetpuh61lvu9ar6vm2i49bnfu5kjb"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gatewayglobal.ggapp",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#011F4A"
      }
    },
    "android": {
      "package": "com.gatewayglobal.ggapp",
      "adaptiveIcon": {
        "backgroundColor": "#011F4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#011F4A"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#011F4A"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#011F4A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GG'APP to use your location to show nearby healthcare providers and driving distances.",
          "locationWhenInUsePermission": "Allow GG'APP to use your location to show nearby healthcare providers and driving distances."
        }
      ],
      "expo-sharing",
      "expo-notifications",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Allow GG'APP to add your appointments to your calendar.",
          "calendarPermission": "Allow GG'APP to add your appointments to your calendar.",
          "remindersPermission": false
        }
      ]
    ]
  }
}

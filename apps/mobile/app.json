{
  "expo": {
    "name": "GG'APP",
    "slug": "gg-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "ggapp",
      "com.googleusercontent.apps.335540055294-raieetpuh61lvu9ar6vm2i49bnfu5kjb"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gatewayglobal.ggapp"
    },
    "android": {
      "package": "com.gatewayglobal.ggapp",
      "adaptiveIcon": {
        "backgroundColor": "#011F4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#011F4A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GG'APP to use your location to show nearby healthcare providers and driving distances.",
          "locationWhenInUsePermission": "Allow GG'APP to use your location to show nearby healthcare providers and driving distances."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GG'APP to use your photos so you can set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "ggapp-alerts",
          "color": "#011F4A"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Allow GG'APP to add your appointments to your calendar.",
          "calendarPermission": "Allow GG'APP to add your appointments to your calendar.",
          "remindersPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "993ee4f3-5bba-47bc-bf7a-cfa0d08ea343"
      }
    },
    "owner": "fannonb",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/993ee4f3-5bba-47bc-bf7a-cfa0d08ea343",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}

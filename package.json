    "typecheck": "tsc --noEmit -p apps/mobile"
  },
  "dependencies": {
    "@expo/log-box": "^57.0.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.14",
    "expo-asset": "^57.0.19"
  }
}
